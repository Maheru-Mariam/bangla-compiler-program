পূর্ণসংখ্যা বাইরে = ০;

যতক্ষণ (বাইরে < ৩) {
    পূর্ণসংখ্যা ভিতরে = ০;

    যতক্ষণ (ভিতরে < ২) {
        যদি (ভিতরে == ১) {
            দেখাও(সত্যি);
        } নাহয় {
            যদি (ভিতরে == ১) {
                দেখাও(সত্যি);
            } নাহয় {
                দেখাও(মিথ্যা);
                দেখাও(মিথ্যা);
            }
        }
        ভিতরে = ভিতরে + ১;
    }

    বাইরে = বাইরে + ১;
}