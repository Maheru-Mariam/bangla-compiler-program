# ---------- পূর্ণসংখ্যা ও দশমিকসংখ্যা ----------
পূর্ণসংখ্যা গণনা = ০;
পূর্ণসংখ্যা সীমা = ৫;
দশমিকসংখ্যা পাই = ৩.১৪;
দশমিকসংখ্যা ভুল = পাই;

# ---------- পাটিগণিত ও অগ্রাধিকার ----------
পূর্ণসংখ্যা যোগফল = ২ + ৩;
পূর্ণসংখ্যা গুণফল = ৪ * ৫;
পূর্ণসংখ্যা জটিল = (২ + ৩) * ৪ - ১;
দশমিকসংখ্যা দশমিকগণনা = ১.৫ + ২.৫;

# ভাগ সবসময় দশমিক দেয়: ৭ / ২ = ৩.৫
দশমিকসংখ্যা ভাগফল = ৭ / ২;
দশমিকসংখ্যা গোটা = ৫;

# ---------- লেখা ----------
লেখা বার্তা = "নমস্কার, বিশ্ব!";
লেখা নাম = "জহুরুল";
লেখা পূর্ণ = বার্তা + " " + নাম;

# ---------- বুলিয়ান ----------
বুলিয়ান চালু = সত্যি;
বুলিয়ান বন্ধ = মিথ্যা;
বুলিয়ান সমান = (বার্তা == নাম);

# ---------- যতক্ষণ লুপ ----------
যতক্ষণ (গণনা < সীমা) {
    দেখাও(গণনা);
    গণনা = গণনা + ১;
}

# ---------- প্রতি লুপ (পরিসর) ----------
প্রতি (ধাপগণনা = ০ থেকে ৩) {
    দেখাও(ধাপগণনা);
}

প্রতি (জোড় = ০ থেকে ১০ ধাপ ২) {
    দেখাও(জোড়);
}

# ---------- যদি / নাহয় ----------
যদি (গণনা == সীমা) {
    দেখাও("লুপ শেষ");
} নাহয় {
    দেখাও("লুপ শেষ হয়নি");
}

যদি (চালু && !বন্ধ) {
    দেখাও(সত্যি);
} নাহয় {
    দেখাও(মিথ্যা);
}

# ---------- ফলাফল দেখাও ----------
দেখাও(যোগফল);
দেখাও(জটিল);
দেখাও(দশমিকগণনা);
দেখাও(ভাগফল);
দেখাও(গোটা);
দেখাও(পূর্ণ);
দেখাও("ট্যাব:\tশেষ");
দেখাও("উদ্ধৃতি: \"হ্যালো\"");
দেখাও(সমান);